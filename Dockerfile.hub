FROM golang:1.22-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /argus-hub ./cmd/hub

FROM alpine:3.20
RUN apk add --no-cache ca-certificates
WORKDIR /app
COPY --from=build /argus-hub /app/argus-hub
EXPOSE 8080
ENTRYPOINT ["/app/argus-hub"]
