server {
  listen 80;
  root /usr/share/nginx/html;
  index index.html;

  location /api/ {
    proxy_pass http://argus-hub:8080;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header Authorization "Bearer ${ARGUS_AGENT_TOKEN}";
  }

  location /health {
    proxy_pass http://argus-hub:8080;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}

# Remote agents: only the ingest POSTs. Query routes are not proxied here.
server {
  listen 8081;
  client_max_body_size 8m;

  location ~ ^/(api/v1/(agents/(register|heartbeat)|metrics/batch|logs/batch|events|fleet/batch)|v1/traces)$ {
    limit_except POST { deny all; }
    proxy_pass http://argus-hub:8080;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  }

  location = /health {
    proxy_pass http://argus-hub:8080;
  }

  location / {
    return 404;
  }
}
