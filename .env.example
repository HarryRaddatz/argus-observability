ARGUS_HUB_ADDR=:8080
ARGUS_STORE_PATH=/data/argus.db
ARGUS_AGENT_TOKEN=change-me

# Retenção SQLite (defaults: logs 7d, métricas/eventos 30d, purge a cada 1h, timeout 5s)
ARGUS_RETENTION_LOGS=168h
ARGUS_RETENTION_METRICS=720h
ARGUS_RETENTION_EVENTS=720h
ARGUS_PURGE_INTERVAL=1h
ARGUS_PURGE_TIMEOUT=5s

ARGUS_HUB_URL=http://argus-hub:8080
ARGUS_AGENT_ID=argus-agent
ARGUS_HOST_ID=docker-host
ARGUS_COLLECT_INTERVAL=15s
