ARGUS_HUB_ADDR=:8080
ARGUS_STORE_DRIVER=postgres
ARGUS_STORE_DSN=postgres://argus:change-me@postgres:5432/argus?sslmode=disable
ARGUS_AGENT_TOKEN=change-me

# Retenção SQLite (defaults: logs 7d, métricas/eventos 30d, purge a cada 1h, timeout 5s)
ARGUS_RETENTION_LOGS=168h
ARGUS_RETENTION_METRICS=720h
ARGUS_RETENTION_EVENTS=720h
ARGUS_PURGE_INTERVAL=1h
ARGUS_PURGE_TIMEOUT=5s

# Ingest de vários agents: vagas simultâneas, espera antes do 503 e corpo máximo
ARGUS_INGEST_CONCURRENCY=8
ARGUS_INGEST_WAIT=2s
ARGUS_MAX_BODY_BYTES=8388608

ARGUS_HUB_URL=http://argus-hub:8080
ARGUS_AGENT_ID=argus-agent
ARGUS_HOST_ID=docker-host
ARGUS_COLLECT_INTERVAL=15s

# Kernel collector: observed dependencies and connection counts. Needs the
# capabilities and the tracefs mount documented in docs/api/configuration.md.
ARGUS_EBPF=0
ARGUS_EBPF_INTERVAL=30s
ARGUS_BUFFER_DIR=/var/lib/argus/buffer
ARGUS_BUFFER_MAX_BYTES=67108864
